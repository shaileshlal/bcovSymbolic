digraph "Module import graph (live modules, historical scripts, entry points)" {
  graph [rankdir=LR, concentrate=true, newrank=true, nodesep=0.25, ranksep=0.9, fontname="Helvetica", label="Module import graph (live modules, historical scripts, entry points)", labelloc=t, fontsize=18];
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", fontname="Helvetica", fontsize=11];
  edge [color="#555555", arrowsize=0.6];
  subgraph cluster_0 { label="bcov"; style="rounded,filled"; fillcolor="#eef3fb"; color="#999999";
    "bcov.__init__" [label="__init__"];
    "bcov.bcov_yy" [label="bcov_yy (module functions)"];
    "bcov.cli" [label="cli (module functions)"];
    "bcov.datasets" [label="datasets (module functions)"];
    "bcov.patterns" [label="patterns (module functions)"];
    "bcov.quintic_frames" [label="quintic_frames (module functions)"];
    "bcov.verify_physical_qseries" [label="verify_physical_qseries (module functions)"];
  }
  subgraph cluster_1 { label="bcov historical scripts"; style="rounded,filled"; fillcolor="#fdf1e6"; color="#999999";
    "bcov.audit_coefficients" [label="audit_coefficients"];
    "bcov.audit_denominators" [label="audit_denominators"];
    "bcov.test_frames" [label="test_frames"];
    "bcov.test_gu_gauge" [label="test_gu_gauge"];
  }
  subgraph cluster_2 { label="entry points (scripts, notebooks, tests)"; style="rounded,filled"; fillcolor="#eaf6ec"; color="#999999";
    "Quintic_BCOV_Tutorial.py" [label="Quintic_BCOV_Tutorial.py"];
    "notebooks/arithmetic_patterns.py" [label="notebooks/arithmetic_patterns.py"];
    "notebooks/physical_verification.py" [label="notebooks/physical_verification.py"];
    "notebooks/research_overview.py" [label="notebooks/research_overview.py"];
    "run_all_checks.py" [label="run_all_checks.py"];
    "tests/test_package.py" [label="tests/test_package.py"];
    "tests/test_research_exact.py" [label="tests/test_research_exact.py"];
    "tests/test_research_integration.py" [label="tests/test_research_integration.py"];
  }
  subgraph cluster_3 { label="quintic_bcov_lab"; style="rounded,filled"; fillcolor="#f6ecf6"; color="#999999";
    "quintic_bcov_lab.__init__" [label="__init__"];
    "quintic_bcov_lab.__main__" [label="__main__ (module functions)"];
    "quintic_bcov_lab.arithmetic" [label="arithmetic (module functions)"];
    "quintic_bcov_lab.backend" [label="backend (module functions)"];
    "quintic_bcov_lab.datasets" [label="datasets (module functions)"];
    "quintic_bcov_lab.runner" [label="runner (module functions)"];
    "quintic_bcov_lab.sections" [label="sections (module functions)"];
