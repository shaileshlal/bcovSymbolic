digraph "Frame conversions" {
  graph [rankdir=LR, newrank=true, nodesep=0.25, ranksep=0.9, fontname="Helvetica", label="Frame conversions", labelloc=t, fontsize=18];
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", fontname="Helvetica", fontsize=11];
  edge [color="#555555", arrowsize=0.6];
  subgraph cluster_0 { label="FramedPolynomial"; style="rounded,filled"; fillcolor="#eef3fb"; color="#999999";
    "quintic_frames.FramedPolynomial.__post_init__" [label="__post_init__"];
    "quintic_frames.FramedPolynomial.to" [label="to"];
  }
  subgraph cluster_1 { label="Poly"; style="rounded,filled"; fillcolor="#fdf1e6"; color="#999999";
    "bcov_yy.Poly.substitute" [label="substitute"];
  }
  subgraph cluster_2 { label="YYRing"; style="rounded,filled"; fillcolor="#eaf6ec"; color="#999999";
    "bcov_yy.YYRing.__init__" [label="__init__"];
    "bcov_yy.YYRing.theta" [label="theta"];
  }
  subgraph cluster_3 { label="quintic_frames"; style="rounded,filled"; fillcolor="#f6ecf6"; color="#999999";
    "quintic_frames._frame" [label="_frame"];
    "quintic_frames._genus" [label="_genus"];
    "quintic_frames.hkq_to_yy" [label="hkq_to_yy"];
    "quintic_frames.hkq_to_z" [label="hkq_to_z"];
    "quintic_frames.theta_hkq" [label="theta_hkq"];
    "quintic_frames.theta_z" [label="theta_z"];
    "quintic_frames.yy_to_hkq" [label="yy_to_hkq"];
    "quintic_frames.yy_to_z" [label="yy_to_z"];
    "quintic_frames.z_to_hkq" [label="z_to_hkq"];
    "quintic_frames.z_to_yy" [label="z_to_yy"];
  }
  "quintic_frames.FramedPolynomial.__post_init__" -> "quintic_frames._frame" [style=solid];
  "quintic_frames.FramedPolynomial.__post_init__" -> "quintic_frames._genus" [style=solid];
  "quintic_frames.FramedPolynomial.to" -> "quintic_frames._frame" [style=solid];
  "quintic_frames.FramedPolynomial.to" -> "quintic_frames.hkq_to_yy" [style=dotted, color="#d62728", penwidth=1.6];
  "quintic_frames.FramedPolynomial.to" -> "quintic_frames.hkq_to_z" [style=dashed, color="#1f77b4"];
  "quintic_frames.FramedPolynomial.to" -> "quintic_frames.yy_to_hkq" [style=dashed, color="#1f77b4"];
  "quintic_frames.FramedPolynomial.to" -> "quintic_frames.yy_to_z" [style=dashed, color="#1f77b4"];
  "quintic_frames.FramedPolynomial.to" -> "quintic_frames.z_to_hkq" [style=dotted, color="#d62728", penwidth=1.6];
  "quintic_frames.FramedPolynomial.to" -> "quintic_frames.z_to_yy" [style=dashed, color="#1f77b4"];
  "quintic_frames.hkq_to_yy" -> "bcov_yy.Poly.substitute" [style=dashed, color="#1f77b4"];
  "quintic_frames.hkq_to_yy" -> "quintic_frames._genus" [style=solid];
  "quintic_frames.hkq_to_z" -> "bcov_yy.Poly.substitute" [style=dashed, color="#1f77b4"];
  "quintic_frames.hkq_to_z" -> "quintic_frames._genus" [style=solid];
  "quintic_frames.theta_hkq" -> "bcov_yy.Poly.substitute" [style=dashed, color="#1f77b4"];
  "quintic_frames.theta_hkq" -> "bcov_yy.YYRing.__init__" [style=solid];
  "quintic_frames.theta_hkq" -> "bcov_yy.YYRing.theta" [style=dashed, color="#1f77b4"];
  "quintic_frames.theta_z" -> "bcov_yy.Poly.substitute" [style=dashed, color="#1f77b4"];
  "quintic_frames.theta_z" -> "quintic_frames.theta_hkq" [style=solid];
  "quintic_frames.yy_to_hkq" -> "bcov_yy.Poly.substitute" [style=dashed, color="#1f77b4"];
  "quintic_frames.yy_to_hkq" -> "quintic_frames._genus" [style=solid];
  "quintic_frames.yy_to_z" -> "quintic_frames.hkq_to_z" [style=solid];
  "quintic_frames.yy_to_z" -> "quintic_frames.yy_to_hkq" [style=solid];
  "quintic_frames.z_to_hkq" -> "quintic_frames.hkq_to_z" [style=solid];
  "quintic_frames.z_to_yy" -> "quintic_frames.hkq_to_yy" [style=solid];
  "quintic_frames.z_to_yy" -> "quintic_frames.z_to_hkq" [style=solid];
}
