    "bcov.patterns.low_x_predictions" [label="low_x_predictions"];
    "bcov.patterns.prime_free_part" [label="prime_free_part"];
    "bcov.patterns.pure_x" [label="pure_x"];
  }
  subgraph cluster_6 { label="patterns.PatternReport"; style="rounded,filled"; fillcolor="#f3f0ea"; color="#999999";
    "bcov.patterns.PatternReport.denominator_matches" [label="denominator_matches"];
    "bcov.patterns.PatternReport.low_x_matches" [label="low_x_matches"];
  }
  subgraph cluster_7 { label="quintic_frames.FramedPolynomial"; style="rounded,filled"; fillcolor="#eef3fb"; color="#999999";
