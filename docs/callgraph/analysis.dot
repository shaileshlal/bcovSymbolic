    "bcov.verify_physical_qseries.Series.pow" [label="pow"];
    "bcov.verify_physical_qseries.Series.scale" [label="scale"];
    "bcov.verify_physical_qseries.Series.sub" [label="sub"];
    "bcov.verify_physical_qseries.Series.theta" [label="theta"];
    "bcov.verify_physical_qseries.Series.trunc" [label="trunc"];
  }
