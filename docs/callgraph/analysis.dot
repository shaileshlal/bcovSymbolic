digraph "Data, patterns, physical verification and CLI (Poly primitives omitted)" {
  graph [rankdir=LR, newrank=true, nodesep=0.25, ranksep=0.9, fontname="Helvetica", label="Data, patterns, physical verification and CLI (Poly primitives omitted)", labelloc=t, fontsize=18];
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", fontname="Helvetica", fontsize=11];
  edge [color="#555555", arrowsize=0.6];
  subgraph cluster_0 { label="bcov_yy"; style="rounded,filled"; fillcolor="#eef3fb"; color="#999999";
    "bcov.bcov_yy.demo" [label="demo"];
  }
  subgraph cluster_1 { label="cli"; style="rounded,filled"; fillcolor="#fdf1e6"; color="#999999";
    "bcov.cli.main" [label="main"];
  }
