    "bcov.verify_physical_qseries.expected_gv" [label="expected_gv"];
    "bcov.verify_physical_qseries.periods" [label="periods"];
    "bcov.verify_physical_qseries.read_gv" [label="read_gv"];
    "bcov.verify_physical_qseries.sine_coefficient" [label="sine_coefficient"];
    "bcov.verify_physical_qseries.verify" [label="verify"];
  }
  subgraph cluster_9 { label="verify_physical_qseries.Series"; style="rounded,filled"; fillcolor="#eaf6ec"; color="#999999";
