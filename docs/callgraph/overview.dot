digraph "Call graph by class and module" {
  graph [rankdir=LR, newrank=true, nodesep=0.25, ranksep=0.9, fontname="Helvetica", label="Call graph by class and module", labelloc=t, fontsize=18];
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", fontname="Helvetica", fontsize=11];
  edge [color="#555555", arrowsize=0.6];
  "group.Amplitude" [label="Amplitude", fillcolor="#eef3fb"];
  "group.BCOV" [label="BCOV", fillcolor="#fdf1e6"];
  "group.FramedPolynomial" [label="FramedPolynomial", fillcolor="#eaf6ec"];
  "group.Poly" [label="Poly", fillcolor="#f6ecf6"];
  "group.Recipe" [label="Recipe", fillcolor="#fbf8e3"];
  "group.RecipeArena" [label="RecipeArena", fillcolor="#e8f4f6"];
  "group.YYRing" [label="YYRing", fillcolor="#f3f0ea"];
  "group.bcov_yy" [label="bcov_yy", fillcolor="#eef3fb"];
  "group.quintic_frames" [label="quintic_frames", fillcolor="#fdf1e6"];
  "group.Amplitude" -> "group.Poly" [style=dashed, color="#1f77b4"];
  "group.Amplitude" -> "group.bcov_yy" [style=solid];
  "group.BCOV" -> "group.Amplitude" [style=solid];
  "group.BCOV" -> "group.Poly" [style=dashed, color="#1f77b4"];
  "group.BCOV" -> "group.Recipe" [style=dashed, color="#1f77b4"];
  "group.BCOV" -> "group.RecipeArena" [style=solid];
  "group.BCOV" -> "group.YYRing" [style=solid];
  "group.BCOV" -> "group.bcov_yy" [style=solid];
  "group.FramedPolynomial" -> "group.quintic_frames" [style=solid];
  "group.Poly" -> "group.bcov_yy" [style=solid];
  "group.Recipe" -> "group.RecipeArena" [style=solid];
  "group.RecipeArena" -> "group.Poly" [style=dashed, color="#1f77b4"];
  "group.RecipeArena" -> "group.Recipe" [style=solid];
  "group.RecipeArena" -> "group.YYRing" [style=solid];
  "group.YYRing" -> "group.Poly" [style=solid];
  "group.bcov_yy" -> "group.Amplitude" [style=dashed, color="#1f77b4"];
  "group.bcov_yy" -> "group.BCOV" [style=solid];
  "group.bcov_yy" -> "group.Poly" [style=solid];
  "group.bcov_yy" -> "group.Recipe" [style=dashed, color="#1f77b4"];
  "group.bcov_yy" -> "group.RecipeArena" [style=solid];
  "group.quintic_frames" -> "group.Poly" [style=dashed, color="#1f77b4"];
  "group.quintic_frames" -> "group.YYRing" [style=solid];
}
